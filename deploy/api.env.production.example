# Copy these values into api/.env ON THE SERVER (never commit the real file).
# Replace yourdomain.com with your real domain.

APP_NAME="GuruGanesh Graphics API"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.yourdomain.com
# Run "php artisan key:generate" on the server to fill this in.
APP_KEY=

# Only the exact addresses of your storefront and admin, no trailing slash.
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://admin.yourdomain.com

LOG_CHANNEL=stack
LOG_LEVEL=error

# --- Database: simplest option, keep SQLite -------------------------------
DB_CONNECTION=sqlite
# Full path to the database file you upload (keep it OUTSIDE public_html):
DB_DATABASE=/home/CPANELUSER/guruganesh/api/guruganesh

# --- Or MySQL (create the database and user in cPanel -> MySQL Databases) --
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=cpaneluser_guruganesh
# DB_USERNAME=cpaneluser_guru
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Mail: use the mailbox you create in cPanel -> Email Accounts.
MAIL_MAILER=smtp
MAIL_HOST=mail.yourdomain.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=hello@yourdomain.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@yourdomain.com
MAIL_FROM_NAME="GuruGanesh Graphics"

DESIGN_FILES_DRIVER=local

# IMPORTANT: see "Customer login (OTP)" in DEPLOYMENT.md before changing this.
OTP_TEST_MODE=false
