# Dependencies
**/node_modules/
**/vendor/

# Next.js build output (admin/, web/)
**/.next/
**/out/
**/build/
**/*.tsbuildinfo
**/next-env.d.ts

# Laravel (api/)
**/bootstrap/cache/*.php
**/storage/app/public/*
!**/storage/app/public/.gitkeep
**/storage/framework/cache/data/*
**/storage/framework/sessions/*
**/storage/framework/testing/*
**/storage/framework/views/*
**/storage/logs/*
!**/storage/logs/.gitkeep
**/public/storage
**/.phpunit.result.cache
**/Homestead.json
**/Homestead.yaml
**/auth.json

# Environment / secrets — never commit these
**/.env
**/.env.*
!**/.env.example

# Logs
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / editor junk
**/.DS_Store
**/Thumbs.db
**/.vscode/*
!**/.vscode/extensions.json
**/.idea/

# Misc caches
**/.turbo/
**/.cache/
