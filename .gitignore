# ---------------------------------------------------------------------------
# Only the three apps and a few top-level docs belong in git. Everything else
# in this folder (product photo folders, spreadsheets, helper scripts, logos,
# test reports) is working material and stays on your computer.
# ---------------------------------------------------------------------------
/*
!/.gitignore
!/README.md
!/DEPLOYMENT.md
!/admin/
!/api/
!/web/
!/deploy/
!/assets/

# Dependencies
**/node_modules/
**/vendor/

# Next.js build output (admin/, web/)
**/.next/
**/out/
**/build/
**/*.tsbuildinfo
**/next-env.d.ts

# Laravel (api/)
**/bootstrap/cache/*.php
**/storage/app/public/*
!**/storage/app/public/.gitkeep
**/storage/framework/cache/data/*
**/storage/framework/sessions/*
**/storage/framework/testing/*
**/storage/framework/views/*
**/storage/logs/*
!**/storage/logs/.gitkeep
**/public/storage
**/.phpunit.result.cache
**/Homestead.json
**/Homestead.yaml
**/auth.json

# The live database and uploaded customer files — never in git
/api/guruganesh
**/*.sqlite
**/*.sqlite3
**/storage/app/private/*
!**/storage/app/private/.gitignore

# Environment / secrets — never commit these
**/.env
**/.env.*
!**/.env.example

# Stray files
**/,
**/nul*

# Logs
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / editor junk
**/.DS_Store
**/Thumbs.db
**/.vscode/*
!**/.vscode/extensions.json
**/.idea/

# Misc caches
**/.turbo/
**/.cache/
