APP_NAME="GuruGanesh Graphics API"
APP_ENV=local
APP_KEY=
# Set to false in staging/production — a debug-mode error page exposes
# stack traces, file paths and env values to anyone who triggers a 500.
APP_DEBUG=true
APP_URL=http://localhost:8000

# Comma-separated, no trailing slashes. Set explicitly per environment —
# never left open with '*', since write routes carry admin credentials.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

SANCTUM_TOKEN_EXPIRATION=720

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Where customer-uploaded design files (artwork) are stored — see the
# 'design_files' disk in config/filesystems.php. Defaults to local disk
# storage under storage/app/private/design-files, which works with no
# extra setup. Once an S3 bucket exists, set this to `s3`, fill in the
# AWS_* values above, and `composer require league/flysystem-aws-s3-v3` —
# no code changes needed.
DESIGN_FILES_DRIVER=local

# Customer registration/login is phone + OTP (see OtpAuthController). No
# SMS gateway is subscribed to yet, so while this is true: the "request
# code" response includes the code directly (debug_code) instead of it
# only going out by SMS, and POST /auth/otp/skip (register with no code,
# for testing) is reachable. Set to false once a real gateway is wired
# into App\Services\SmsService::send() — that alone shuts off both.
OTP_TEST_MODE=true

VITE_APP_NAME="${APP_NAME}"
